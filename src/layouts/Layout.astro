---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import MobileHeader from "../components/MobileHeader.astro";
import BootScreen from "../components/BootScreen.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Green Pendap Production",
  description = "Professional Game Development Studio",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logoNoText.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen md:h-screen w-full md:w-screen bg-gpp-bg text-gpp-text overflow-y-auto overflow-x-hidden md:overflow-hidden relative">
    <BootScreen />
    <MobileHeader />
    <Sidebar />
    <!-- Desktop Area / Mobile Scroll Area -->
    <main class="relative w-full min-h-screen mt-16 md:mt-0 md:absolute md:inset-0 md:h-full md:pointer-events-none">
        <slot />
    </main>
  </body>
</html>
