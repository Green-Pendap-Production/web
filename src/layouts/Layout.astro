---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import MobileHeader from "../components/MobileHeader.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Green Pendap Production",
  description = "Professional Game Development Studio",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logoNoText.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen bg-gpp-bg text-gpp-text">
    <MobileHeader />
    <Sidebar />
    <!-- Main Content Area with left margin to accommodate fixed sidebar -->
    <main
      class="w-full overflow-x-hidden ml-0 md:ml-64 px-4 min-h-screen md:mr-72 mr-0 mt-16 md:mt-0"
    >
      <slot />
      <Footer />
    
    </main>
  </body>
</html>
