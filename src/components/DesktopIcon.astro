---
export interface Props {
  id: string;
  label: string;
  type: 'exe' | 'folder' | 'txt' | 'msg';
}

const { id, label, type } = Astro.props;
---

<button class="desktop-icon group flex flex-col items-center w-20 md:w-24 gap-2 p-2 rounded border-2 border-transparent hover:bg-white/10 hover:border-white/20 transition-all focus:bg-white/20 focus:border-white/30 focus:outline-none" data-target={id}>
  <div class="w-12 h-12 flex items-center justify-center drop-shadow-[2px_4px_0_rgba(47,79,47,0.4)] transform group-hover:-translate-y-1 group-hover:scale-110 transition-all duration-300">
    {type === 'folder' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="#ffeb3b" stroke="#2f4f2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
      </svg>
    )}
    {type === 'exe' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="#fff9e6" stroke="#2f4f2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
    )}
    {type === 'txt' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="#ffffff" stroke="#2f4f2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
    )}
    {type === 'msg' && (
      <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="#ffffff" stroke="#2f4f2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
    )}
  </div>
  <span class="text-xs font-medium text-white bg-gpp-primary px-1.5 py-0.5 rounded border border-gpp-primary shadow-[2px_2px_0_0_rgba(0,0,0,0.3)] text-center break-words w-full line-clamp-2 leading-tight select-none">
    {label}
  </span>
</button>
