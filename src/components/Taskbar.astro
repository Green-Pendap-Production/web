---
export interface TaskbarIcon {
  id: string;
  label: string;
  type: "exe" | "folder" | "txt" | "msg";
}

export interface Props {
  icons: TaskbarIcon[];
}

const { icons } = Astro.props;
---

<!-- Taskbar — hidden by default, shown after bootComplete -->
<div
  id="taskbar"
  class="md:flex hidden fixed bottom-0 left-0 right-0 z-[999] items-center gap-2 px-4 py-2 pointer-events-auto"
  style="background: rgba(244,244,240,0.92); backdrop-filter: blur(12px); border-top: 4px solid #2f4f2f; box-shadow: 0 -4px 0 0 rgba(47,79,47,0.15); opacity: 0; transform: translateY(100%); transition: opacity 0.4s ease, transform 0.4s ease;"
>
  <!-- Brand pill left -->
  <div class="flex items-center gap-2 pr-3 mr-1 border-r-2 border-gpp-primary/30 shrink-0">
    <div class="w-6 h-6 rounded-full bg-gpp-primary flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff9e6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="3" width="20" height="14" rx="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
    </div>
    <span class="font-heading text-gpp-primary text-sm uppercase tracking-wide leading-none mt-0.5 select-none">GPP</span>
  </div>

  <!-- Window buttons -->
  <div id="taskbar-buttons" class="flex items-center gap-1.5 flex-1 overflow-x-auto min-w-0" style="scrollbar-width: none;">
    {icons.map((icon) => (
      <button
        class="taskbar-btn group relative flex items-center gap-2 px-3 py-1.5 rounded-lg border-2 font-bold text-gpp-primary transition-all duration-150 shrink-0 select-none"
        data-target={icon.id}
        oncontextmenu="event.preventDefault()"
      >
        <!-- Icon -->
        <span class="w-4 h-4 shrink-0 flex items-center justify-center">
          {icon.type === "folder" && (
            <svg class="icon-svg" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="#ffeb3b" stroke="#2f4f2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
          )}
          {icon.type === "exe" && (
            <svg class="icon-svg" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="#c8e6c9" stroke="#2f4f2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          )}
          {icon.type === "txt" && (
            <svg class="icon-svg" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="#ffffff" stroke="#2f4f2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          )}
          {icon.type === "msg" && (
            <svg class="icon-svg" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="#ffffff" stroke="#2f4f2f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          )}
        </span>

        <!-- Label: always visible, white when active -->
        <span class="taskbar-label font-heading uppercase tracking-wide text-[11px] leading-none mt-0.5 whitespace-nowrap">{icon.label}</span>

        <!-- Active dot -->
        <span class="taskbar-dot absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full opacity-0 transition-opacity duration-150" style="background:#ffeb3b;"></span>
      </button>
    ))}
  </div>

  <!-- Clock right -->
  <div class="shrink-0 pl-3 ml-1 border-l-2 border-gpp-primary/30 text-right">
    <div id="taskbar-time" class="font-heading text-gpp-primary text-sm uppercase tracking-wide leading-none"></div>
    <div id="taskbar-date" class="font-body text-gpp-muted text-[10px] mt-0.5 leading-none"></div>
  </div>
</div>

<style>
  #taskbar-buttons::-webkit-scrollbar { display: none; }

  /* Default state */
  .taskbar-btn {
    background: transparent;
    border-color: transparent;
    color: #2f4f2f;
  }

  /* Hover (not active) */
  .taskbar-btn:not(.is-open):hover {
    background: rgba(47,79,47,0.08);
    border-color: rgba(47,79,47,0.25);
  }

  /* Active / open state */
  .taskbar-btn.is-open {
    background: #2f4f2f;
    border-color: #2f4f2f;
    box-shadow: 0 3px 0 0 rgba(47,79,47,0.5), inset 0 1px 0 0 rgba(255,255,255,0.1);
    color: #fff9e6;
  }

  .taskbar-btn.is-open .taskbar-label {
    color: #fff9e6;
  }

  .taskbar-btn.is-open .taskbar-dot {
    opacity: 1;
  }

  /* Flip icon stroke/fill when active */
  .taskbar-btn.is-open .icon-svg {
    filter: brightness(0) invert(1);
  }

  /* Taskbar slide-in animation class */
  #taskbar.taskbar-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const taskbar = document.getElementById("taskbar");

    // --- 1. Show taskbar only after bootComplete ---
    document.addEventListener("bootComplete", () => {
      if (taskbar && window.innerWidth >= 768) {
        // Small delay so it slides in after windows start appearing
        setTimeout(() => taskbar.classList.add("taskbar-visible"), 600);
      }
    });

    // --- 2. Block right-click on taskbar ---
    if (taskbar) {
      taskbar.addEventListener("contextmenu", (e) => e.preventDefault());
    }

    // --- 3. Clock ---
    const timeEl = document.getElementById("taskbar-time");
    const dateEl = document.getElementById("taskbar-date");
    function updateClock() {
      const now = new Date();
      if (timeEl) timeEl.textContent = now.toLocaleTimeString("id-ID", { hour: "2-digit", minute: "2-digit" });
      if (dateEl) dateEl.textContent = now.toLocaleDateString("id-ID", { day: "2-digit", month: "short" });
    }
    updateClock();
    setInterval(updateClock, 10000);

    // --- 4. Taskbar button click: toggle window ---
    const taskbarBtns = document.querySelectorAll<HTMLButtonElement>(".taskbar-btn");
    taskbarBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.dataset.target;
        if (!targetId) return;
        const win = document.getElementById(`window-${targetId}`);
        if (!win) return;
        const isOpen = !win.classList.contains("md:pointer-events-none");
        if (isOpen) {
          (window as any).closeWindow?.(targetId);
        } else {
          (window as any).openWindow?.(targetId);
        }
      });
    });

    // --- 5. Sync active state by polling (covers gsap animation delay) ---
    function syncTaskbar() {
      taskbarBtns.forEach((btn) => {
        const targetId = btn.dataset.target;
        if (!targetId) return;
        const win = document.getElementById(`window-${targetId}`);
        if (!win) return;
        const isOpen = !win.classList.contains("md:pointer-events-none");
        btn.classList.toggle("is-open", isOpen);
      });
    }
    setInterval(syncTaskbar, 150);
  });
</script>