---

---

<div
  id="boot-screen"
  class="fixed inset-0 z-[100] bg-gpp-bg flex flex-col items-center justify-center pointer-events-auto transition-opacity duration-1000 overflow-hidden"
>
  <!-- Grid Background -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: linear-gradient(rgba(255,255,255,0.1) 2px, transparent 2px), linear-gradient(90deg, rgba(255,255,255,0.1) 2px, transparent 2px); background-size: 100px 100px;"
  ></div>

  <div class="flex flex-col items-center gap-4 relative z-20 w-full max-w-md px-6">

    <!-- Logo Container (same as original, starts hidden) -->
    <div
      id="boot-logo-container"
      class="relative origin-bottom opacity-0 scale-50"
    >
      <!-- Splash: circle button wrapping the logo -->
      <button
        id="start-btn"
        class="w-48 h-48 rounded-full bg-gpp-bg border-4 border-gpp-primary flex flex-col items-center justify-center cursor-pointer select-none relative z-10"
        style="box-shadow: 5px 5px 0 0 #2f4f2f;"
        aria-label="Click to start"
      >
        <img
          src="/logoNoText.png"
          alt="GPP OS Logo"
          class="w-36 h-36 object-contain mt-8"
        />
        <span id="start-label" class="font-heading text-l font-semibold text-gpp-primary tracking-wide uppercase mb-7">
          Start
        </span>
      </button>

      <!-- Shadow underneath (same as original) -->
      <div
        id="logo-shadow"
        class="w-24 h-4 bg-black/10 rounded-[100%] mx-auto mt-2 scale-0 opacity-0 transition-all duration-300"
      ></div>
    </div>

    <!-- Studio name + hint, shown during splash -->
    <div id="splash-meta" class="flex flex-col items-center gap-2 opacity-0">
      <p class="font-heading text-xl font-semibold text-gpp-primary tracking-wide tracking-widest text-gpp-muted uppercase">
        Greend Pendap Productions
      </p>
      <p class="font-heading text-sm font-medium text-gpp-primary tracking-wide text-gpp-muted ">Press Start</p>
    </div>

    <!-- Loading Area (hidden until clicked) -->
    <div
      id="loading-area"
      class="w-full flex flex-col items-center opacity-0 scale-90 origin-top"
    >
      <!-- Chunky Progress Bar -->
      <div
        class="w-full h-8 bg-white border-4 border-gpp-primary rounded-full p-1 shadow-[4px_4px_0_0_rgba(47,79,47,1)] relative overflow-hidden"
      >
        <div
          id="boot-progress"
          class="h-full bg-gpp-accent w-0 rounded-full relative"
        >
          <div
            class="absolute top-1 left-2 right-2 h-2 bg-white/30 rounded-full"
          ></div>
        </div>
      </div>

      <!-- Dynamic Text -->
      <div
        class="mt-6 font-heading text-xl md:text-2xl text-gpp-primary tracking-wide min-h-[2rem]"
      >
        <span id="loading-text">Waking up the hamsters...</span>
      </div>
    </div>

  </div>
</div>

<script>
  import { gsap } from "gsap";

  const loadingMessages = [
    "Waking up the hamsters...",
    "Polishing the 3D buttons...",
    "Brewing some coffee...",
    "Inflating the windows...",
    "Ready to play!",
  ];

  const bootSound = new Audio("https://cdn.pixabay.com/audio/2026/05/04/audio_fb524433eb.mp3");

  document.addEventListener("DOMContentLoaded", () => {
    const bootScreen = document.getElementById("boot-screen");
    const logoContainer = document.getElementById("boot-logo-container");
    const logoShadow = document.getElementById("logo-shadow");
    const startBtn = document.getElementById("start-btn");
    const startLabel = document.getElementById("start-label");
    const splashMeta = document.getElementById("splash-meta");
    const loadingArea = document.getElementById("loading-area");
    const bootProgress = document.getElementById("boot-progress");
    const loadingText = document.getElementById("loading-text");

    if (window.innerWidth < 768) {
      if (bootScreen) bootScreen.style.display = "none";
      document.dispatchEvent(new CustomEvent("bootComplete"));
      return;
    }

    if (!bootScreen || !logoContainer || !startBtn || !splashMeta || !loadingArea || !bootProgress || !loadingText || !logoShadow) return;

    // --- Phase 1: Splash screen drops in ---
    const splashTl = gsap.timeline();

    splashTl.to(logoContainer, {
      y: 0,
      opacity: 1,
      scale: 1,
      duration: 0.8,
      ease: "bounce.out",
    }, "+=0.2")
      .to(logoShadow, { scale: 1, opacity: 1, duration: 0.3 }, "-=0.3")
      .to(logoContainer, { scaleY: 0.8, scaleX: 1.15, duration: 0.15, transformOrigin: "bottom" })
      .to(logoContainer, { scaleY: 1, scaleX: 1, duration: 0.3, ease: "elastic.out(1, 0.3)" })
      .to(splashMeta, { opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.1");

    // --- Button hover / press feel ---
    startBtn.addEventListener("mouseenter", () => {
      gsap.to(startBtn, { x: -2, y: -2, boxShadow: "7px 7px 0 0 #2f4f2f", duration: 0.15, ease: "power2.out" });
    });
    startBtn.addEventListener("mouseleave", () => {
      gsap.to(startBtn, { x: 0, y: 0, boxShadow: "5px 5px 0 0 #2f4f2f", duration: 0.15, ease: "power2.out" });
    });
    startBtn.addEventListener("mousedown", () => {
      gsap.to(startBtn, { x: 4, y: 4, boxShadow: "1px 1px 0 0 #2f4f2f", duration: 0.08 });
    });
    startBtn.addEventListener("mouseup", () => {
      gsap.to(startBtn, { x: -2, y: -2, boxShadow: "7px 7px 0 0 #2f4f2f", duration: 0.1 });
    });

    // --- Phase 2: Click → transition to boot sequence ---
    startBtn.addEventListener("click", () => {
      const clickSound = new Audio("https://cdn.freesound.org/previews/321/321806_2567799-lq.mp3");
      clickSound.play().catch(() => {});
      startBtn.style.pointerEvents = "none";
      startBtn.style.pointerEvents = "none";
      splashMeta.style.pointerEvents = "none";

      setTimeout(() => {
        bootSound.play().catch(error => {
          console.log("Audio play diblokir oleh browser:", error);
        });
      }, 500); // <--- Ubah angka ini untuk mengatur durasi delay (dalam milidetik)
      const tl = gsap.timeline();

      // Fade out splash meta + label
      tl.to([splashMeta, startLabel], { 
        opacity: 0, 
        duration: 0.25, 
        ease: "power2.in",
        onComplete: () => {
          splashMeta.style.display = "none"; // Benar-benar menghilangkan elemen dari layout
        }
      })

      // Morph button: shrink border/shadow, grow logo img
      .to(startBtn, {
        width: "128px",
        height: "128px",
        borderWidth: "0px",
        boxShadow: "0px 0px 0 0 #2f4f2f",
        backgroundColor: "transparent",
        duration: 0.35,
        ease: "power2.inOut",
      }, "<")

      // Morph button: shrink border/shadow, grow logo img
      .to(startBtn, {
        width: "128px",
        height: "128px",
        borderWidth: "0px",
        boxShadow: "0px 0px 0 0 #2f4f2f",
        backgroundColor: "transparent",
        duration: 0.35,
        ease: "power2.inOut",
      }, "<")

      // Squash & stretch like the original drop
      .to(logoContainer, { scaleY: 0.8, scaleX: 1.15, duration: 0.15, transformOrigin: "bottom" })
      .to(logoContainer, { scaleY: 1, scaleX: 1, duration: 0.3, ease: "elastic.out(1, 0.3)" })

      // Loading area pops in
      .to(loadingArea, {
        opacity: 1,
        scale: 1,
        duration: 0.5,
        ease: "back.out(1.7)",
      }, "-=0.2")

      // Fill progress bar
      .to(bootProgress, {
        width: "100%",
        duration: 2.5,
        ease: "power1.inOut",
        onUpdate: function () {
          const progress = this.progress();
          const messageIndex = Math.floor(progress * (loadingMessages.length - 1));
          if (loadingText) {
            loadingText.textContent =
              progress === 1
                ? loadingMessages[loadingMessages.length - 1]
                : loadingMessages[messageIndex];
          }
        },
      })

      // Loading area shrinks away
      .to(loadingArea, {
        scale: 0,
        opacity: 0,
        duration: 0.4,
        ease: "back.in(1.5)",
      }, "+=0.3")

      // Logo jumps + launches into space
      .to(logoContainer, { y: -50, scaleY: 1.1, duration: 0.2, ease: "power2.out" })
      .to(logoContainer, { y: 0, scaleY: 0.9, duration: 0.15 })
      .to(logoContainer, { y: -800, opacity: 0, duration: 0.5, ease: "back.in(1.2)" }, "+=0.1")

      // Whole screen slides out
      .to(bootScreen, {
        y: "-100%",
        opacity: 0,
        duration: 0.8,
        ease: "power3.inOut",
        onComplete: () => {
          bootScreen.style.display = "none";
          document.dispatchEvent(new CustomEvent("bootComplete"));
        },
      }, "-=0.3");
    });
  });
</script>