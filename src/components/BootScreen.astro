---

---

<div
  id="boot-screen"
  class="fixed inset-0 z-[100] bg-gpp-bg flex flex-col items-center justify-center pointer-events-auto transition-opacity duration-1000 overflow-hidden"
>
  <div
    class="flex flex-col items-center gap-8 relative z-20 w-full max-w-md px-6"
  >
    <!-- Bouncing Logo Container -->
    <div
      id="boot-logo-container"
      class="relative origin-bottom translate-y-[-200px] opacity-0 scale-50"
    >
      <div class="flex items-center justify-center relative z-10">
        <img
          src="/logoNoText.png"
          alt="GPP OS Logo"
          class="w-32 h-32 object-contain drop-shadow-xl"
        />
      </div>
      <!-- Little shadow underneath the logo to ground it -->
      <div
        id="logo-shadow"
        class="w-24 h-4 bg-black/10 rounded-[100%] mx-auto mt-2 scale-0 opacity-0 transition-all duration-300"
      >
      </div>
    </div>

    <!-- Loading Area -->
    <div
      id="loading-area"
      class="w-full flex flex-col items-center opacity-0 scale-90 origin-top"
    >
      <!-- Chunky Progress Bar -->
      <div
        class="w-full h-8 bg-white border-4 border-gpp-primary rounded-full p-1 shadow-[4px_4px_0_0_rgba(47,79,47,1)] relative overflow-hidden"
      >
        <div
          id="boot-progress"
          class="h-full bg-gpp-accent w-0 rounded-full relative"
        >
          <!-- Glossy highlight on the bar -->
          <div
            class="absolute top-1 left-2 right-2 h-2 bg-white/30 rounded-full"
          >
          </div>
        </div>
      </div>

      <!-- Dynamic Text -->
      <div
        class="mt-6 font-heading text-xl md:text-2xl text-gpp-primary tracking-wide min-h-[2rem]"
      >
        <span id="loading-text">Waking up the hamsters...</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  const loadingMessages = [
    "Waking up the hamsters...",
    "Polishing the 3D buttons...",
    "Brewing some coffee...",
    "Inflating the windows...",
    "Ready to play!",
  ];

  document.addEventListener("DOMContentLoaded", () => {
    const bootScreen = document.getElementById("boot-screen");
    const logoContainer = document.getElementById("boot-logo-container");
    const logoShadow = document.getElementById("logo-shadow");
    const loadingArea = document.getElementById("loading-area");
    const bootProgress = document.getElementById("boot-progress");
    const loadingText = document.getElementById("loading-text");

    if (window.innerWidth < 768) {
      if (bootScreen) bootScreen.style.display = "none";
      document.dispatchEvent(new CustomEvent("bootComplete"));
      return;
    }

    if (
      bootScreen &&
      logoContainer &&
      loadingArea &&
      bootProgress &&
      loadingText &&
      logoShadow
    ) {
      // Setup the master timeline
      const tl = gsap.timeline();

      // 1. Logo drops in and bounces (squash and stretch)
      tl.to(
        logoContainer,
        {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: "bounce.out",
        },
        "+=0.2",
      )
        .to(
          logoShadow,
          {
            scale: 1,
            opacity: 1,
            duration: 0.3,
          },
          "-=0.3",
        )
        // Quick squash after landing
        .to(logoContainer, {
          scaleY: 0.8,
          scaleX: 1.15,
          duration: 0.15,
          transformOrigin: "bottom",
        })
        .to(logoContainer, {
          scaleY: 1,
          scaleX: 1,
          duration: 0.3,
          ease: "elastic.out(1, 0.3)",
        });

      // 2. Loading area pops in
      tl.to(
        loadingArea,
        {
          opacity: 1,
          scale: 1,
          duration: 0.5,
          ease: "back.out(1.7)",
        },
        "-=0.2",
      );

      // 3. Fill the progress bar and change text dynamically
      tl.to(bootProgress, {
        width: "100%",
        duration: 2.5,
        ease: "power1.inOut",
        onUpdate: function () {
          const progress = this.progress();
          const messageIndex = Math.floor(
            progress * (loadingMessages.length - 1),
          );
          if (progress === 1) {
            loadingText.textContent =
              loadingMessages[loadingMessages.length - 1];
          } else {
            loadingText.textContent = loadingMessages[messageIndex];
          }
        },
      });

      // 4. Loading area shrinks away playfully
      tl.to(
        loadingArea,
        {
          scale: 0,
          opacity: 0,
          duration: 0.4,
          ease: "back.in(1.5)",
        },
        "+=0.3",
      );

      // 5. Logo gives one last happy jump before the screen slides up
      tl.to(logoContainer, {
        y: -50,
        scaleY: 1.1,
        duration: 0.2,
        ease: "power2.out",
      })
        .to(logoContainer, {
          y: 0,
          scaleY: 0.9,
          duration: 0.15,
        })
        .to(
          logoContainer,
          {
            y: -800, // Launch into space
            opacity: 0,
            duration: 0.5,
            ease: "back.in(1.2)",
          },
          "+=0.1",
        );

      // 6. Fade/Slide out the entire boot screen
      tl.to(
        bootScreen,
        {
          y: "-100%",
          opacity: 0,
          duration: 0.8,
          ease: "power3.inOut",
          onComplete: () => {
            bootScreen.style.display = "none";
            document.dispatchEvent(new CustomEvent("bootComplete"));
          },
        },
        "-=0.3",
      );
    }
  });
</script>
