---
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="mt-20">
    <div class="bg-gpp-primary text-gpp-bg rounded-t-[2rem] md:p-14 p-7">
        <div class="w-full">
            <div class="w-full flex flex-col">
                <div class="w-full pb-40">
                    <h2
                        class="text-4xl md:text-6xl font-heading mb-8 tracking-tighter"
                    >
                        Let's Talk
                    </h2>
                    <div class="space-y-1">
                        <p
                            class="text-white/40 text-sm font-mono uppercase tracking-[0.2em]"
                        >
                            General Inquiries
                        </p>
                        <a
                            href="mailto:greenpendapi@gmail.com"
                            class="text-2xl font-medium block"
                        >
                            greenpendap@gmail.com
                        </a>
                    </div>
                </div>
                <!-- Bottom -->
                <div class="w-full flex gap-2 justify-between border-t border-gray-400/40 pt-10">
                    <p class="">
                        © 2025 Green Pendap Production. All rights reserved.
                    </p>
                    <a href="https://www.instagram.com/greenpendapproject/" target="_blank" rel="noopener noreferrer">Instagram</a>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
    /* Clean transition for links */
    footer a {
        transition: opacity 0.2s ease;
    }
    footer a:hover {
        opacity: 1;
    }
</style>
