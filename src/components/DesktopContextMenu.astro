---
export interface MenuIcon {
    id: string;
    label: string;
    type: "exe" | "folder" | "txt" | "msg";
}

export interface Props {
    icons: MenuIcon[];
}

const { icons } = Astro.props;
---

<div
    id="desktop-context-menu"
    class="fixed min-w-67.5 bg-gpp-bg border-4 border-gpp-primary rounded-2xl shadow-[8px_8px_0px_0px_rgba(47,79,47,1)] p-2.5 z-50 opacity-0 scale-90 origin-top-left pointer-events-none transition-[opacity,transform] duration-150 ease-out z-9999"
    role="menu"
    aria-label="Desktop context menu"
>
    <div
        class="font-heading text-xs uppercase tracking-wider text-gpp-accent px-4 pt-2 pb-1.5 font-semibold"
    >
        Open Window
    </div>

    {
        icons.map((icon) => (
            <button
                class="context-menu-item flex items-center gap-3 w-full px-4 py-2.5 rounded-xl font-bold text-base text-gpp-primary hover:bg-gpp-primary hover:text-[#fff9e6] text-left"
                role="menuitem"
                data-target={icon.id}
            >
                <span class="w-5 h-5 flex items-center justify-center shrink-0">
                    {icon.type === "folder" && (
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="100%"
                            height="100%"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        </svg>
                    )}
                    {icon.type === "exe" && (
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="100%"
                            height="100%"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect
                                x="2"
                                y="3"
                                width="20"
                                height="14"
                                rx="2"
                                ry="2"
                            />
                            <line x1="8" y1="21" x2="16" y2="21" />
                            <line x1="12" y1="17" x2="12" y2="21" />
                        </svg>
                    )}
                    {icon.type === "txt" && (
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="100%"
                            height="100%"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                        </svg>
                    )}
                    {icon.type === "msg" && (
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="100%"
                            height="100%"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                            <polyline points="22,6 12,13 2,6" />
                        </svg>
                    )}
                </span>
                {icon.label}
            </button>
        ))
    }
</div>

<style>
    #desktop-context-menu.open {
        opacity: 1;
        transform: scale(1);
        pointer-events: auto;
    }
    #desktop-context-menu:not(.open) {
        transform: scale(0.9);
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const menuEl = document.getElementById("desktop-context-menu");
        if (!menuEl) return;
        const menu = menuEl as HTMLElement;

        const items = Array.from(
            menu.querySelectorAll<HTMLButtonElement>(".context-menu-item"),
        );
        let activeIndex = -1;

        function setActive(index: number) {
            activeIndex = index;
            items.forEach((item, idx) => {
                item.classList.toggle("bg-gpp-primary", idx === index);
                item.classList.toggle("text-[#fff9e6]", idx === index);
            });
            if (index >= 0) items[index]?.focus();
        }

        function closeMenu() {
            menu.classList.remove("open");
            activeIndex = -1;
        }

        function openMenuAt(x: number, y: number) {
            closeMenu();

            // Posisi sementara di luar layar untuk mengukur ukuran real menu
            menu.style.left = `-9999px`;
            menu.style.top = `-9999px`;
            menu.style.visibility = `hidden`;
            menu.classList.add("open");

            requestAnimationFrame(() => {
                const rect = menu.getBoundingClientRect();
                const taskbarH = 56; // tinggi taskbar bawah

                let posX = x;
                let posY = y;

                // Mepet kanan → geser ke kiri kursor
                if (x + rect.width > window.innerWidth - 8) {
                    posX = x - rect.width;
                }

                // Mepet bawah (termasuk taskbar) → geser ke atas kursor
                if (y + rect.height > window.innerHeight - taskbarH - 8) {
                    posY = y - rect.height;
                }

                // Jaga supaya tidak keluar dari tepi kiri/atas
                posX = Math.max(8, posX);
                posY = Math.max(8, posY);

                menu.style.left = `${posX}px`;
                menu.style.top = `${posY}px`;
                menu.style.visibility = ``;
            });
        }

        document.addEventListener("contextmenu", (e) => {
            const target = e.target as HTMLElement;

            // Biarkan klik kanan di dalam window (Welcome.exe, dll) pakai context
            // menu bawaan browser seperti biasa -- menu desktop ini cuma untuk
            // klik kanan di area wallpaper/background.
            if (target.closest("[data-window]")) return;

            // Jangan trigger ulang kalau klik kanan justru kena menu itu sendiri
            if (target.closest("#desktop-context-menu")) {
                e.preventDefault();
                return;
            }

            e.preventDefault();
            openMenuAt(e.clientX, e.clientY);
        });

        document.addEventListener("click", (e) => {
            if (!menu.contains(e.target as Node)) closeMenu();
        });

        document.addEventListener("keydown", (e) => {
            if (!menu.classList.contains("open")) return;
            if (e.key === "Escape") {
                closeMenu();
                return;
            }
            if (e.key === "ArrowDown") {
                e.preventDefault();
                setActive((activeIndex + 1) % items.length);
            }
            if (e.key === "ArrowUp") {
                e.preventDefault();
                setActive((activeIndex - 1 + items.length) % items.length);
            }
        });

        items.forEach((item) => {
            item.addEventListener("click", () => {
                const targetId = item.dataset.target;
                closeMenu();
                if (targetId) {
                    (window as any).openWindow?.(targetId);
                }
            });
        });
    });
</script>
