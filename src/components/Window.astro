---
interface Props {
  id: string;
  title: string;
  width?: string;
  height?: string;
  initialX?: number | string;
  initialY?: number | string;
  isOpen?: boolean;
}

const { 
  id, 
  title, 
  width = "w-full max-w-2xl md:w-[600px]", 
  height = "md:max-h-[80vh]",
  initialX = 100,
  initialY = 50,
  isOpen = false
} = Astro.props;
---

<div 
  id={`window-${id}`}
  class={`window-container relative md:absolute flex flex-col bg-gpp-bg border-4 border-gpp-primary rounded-2xl overflow-hidden shadow-[8px_8px_0px_0px_rgba(47,79,47,1)] origin-center md:z-10 scale-100 opacity-100 pointer-events-auto ${isOpen ? 'md:scale-100 md:opacity-100 md:pointer-events-auto' : 'md:scale-75 md:opacity-0 md:pointer-events-none'} ${width} ${height}`}
  style={`--initial-x: ${typeof initialX === 'number' ? initialX + 'px' : initialX}; --initial-y: ${typeof initialY === 'number' ? initialY + 'px' : initialY};`}
  data-window
>
  <!-- Window Header / Titlebar -->
  <div class="window-header bg-gpp-bg text-gpp-primary flex justify-between items-center px-4 py-3 cursor-grab active:cursor-grabbing">
    <div class="flex items-center gap-2">
      <div class="w-3 h-3 rounded-full bg-gpp-accent"></div>
      <h3 class="font-heading text-lg tracking-wide uppercase leading-none mt-1">{title}</h3>
    </div>
    <button 
      class="window-close-btn w-8 h-8 hidden md:flex items-center justify-center rounded-full bg-[#ff4747] text-white transition-all border-2 border-gpp-primary shadow-[0_2px_0_0_rgba(47,79,47,1)] active:translate-y-[2px] active:shadow-none hover:bg-[#ff6b6b]"
      aria-label="Close Window"
      data-target={`window-${id}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <!-- Window Body -->
  <div class="flex-1 md:overflow-y-auto overflow-x-hidden bg-gpp-bg p-6 custom-scrollbar relative window-body-pattern">
    <slot />
  </div>
</div>

<style>
  .window-container {
    left: auto;
    top: auto;
  }
  @media (min-width: 768px) {
    .window-container {
      left: var(--initial-x);
      top: var(--initial-y);
    }
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 12px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: var(--color-gpp-bg);
    border-left: 2px solid rgba(0,0,0,0.05);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: var(--color-gpp-primary);
    border-radius: 10px;
    border: 3px solid var(--color-gpp-bg);
  }
  .window-body-pattern {
    background-image: radial-gradient(rgba(47, 79, 47, 0.05) 2px, transparent 2px);
    background-size: 20px 20px;
  }
</style>
