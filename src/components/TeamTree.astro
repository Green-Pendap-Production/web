---
const managementData = {
  name: "Direksi",
  members: [
    { role: "Business Director", name: "Abdul Vaiz Vahry Iskandar" },
    { role: "Operations Director", name: "Muhammad Yusuf Alfarabi" },
    { role: "Project Management Director", name: "Vikri Abdullah Razzak" },
    { role: "Creative Director", name: "Zora Ghaziyah Wanie" },
    { role: "Technical Director", name: "Rifqi Reis Ramadhan" },
    { role: "Artist Director", name: "Haekal Abdillah Ramadhan" },
  ],
};

const divisionData = [
  {
    name: "Production Team",
    members: [
      { name: "Abdul Vaiz Vahry Iskandar", role: "Programming" },
      { name: "Muhammad Yusuf Alfarabi", role: "Programming" },
      { name: "Kevin Stevino Arnovan", role: "Audio" },
      { name: "Zora Ghaziyah Wanie", role: "3D Design" },
      { name: "Rifqi Reis Ramadhan", role: "Programming" },
      { name: "Atiqah Najla Fadhilah Rachman", role: "2D Design" },
      { name: "Zahra Alifia Anshori", role: "2D Design" },
      { name: "Muhamad Gazril Alfarizi", role: "3D Design" },
      { name: "Vikri Abdullah Razzak", role: "Programming" },
      { name: "Haekal Abdillah Ramadhan", role: "2D Design" },
      { name: "Kaysa Naura", role: "2D Design" },
      { name: "Rafi Andika", role: "Audio" },
    ],
  },
];
---

<div class="team-container w-full mt-8">
  <!-- Management / Direksi -->
  <div class="team-category mb-24">
    <div class="flex flex-col mb-10">
      <h3 class="text-3xl md:text-4xl font-heading text-gpp-primary mb-2 inline-block border-b-4 border-gpp-primary pb-2">
        {managementData.name}
      </h3>
      <p class="text-gpp-text/80 font-medium">Leading the vision and strategy.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        managementData.members.map((member) => (
          <div class="group relative bg-[#fff9e6] overflow-hidden border-2 border-gpp-primary/20 rounded-2xl p-6 hover:-translate-y-1 transition-transform duration-300 shadow-md flex flex-col justify-between min-h-[140px]">
            <!-- Decorative Tape -->
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-12 h-6 bg-white/50 border-2 border-gpp-primary/20 rotate-3 z-20"></div>
            
            <div class="relative z-10 flex flex-col h-full justify-between gap-4 mt-2">
              <div class="flex items-start justify-between">
                <span class="text-xs md:text-sm font-heading uppercase tracking-wider text-white bg-gpp-primary px-3 py-1 rounded-md border-2 border-gpp-primary shadow-[2px_2px_0_0_rgba(0,0,0,0.2)] inline-block">{member.role}</span>
              </div>
              <h4 class="text-xl md:text-2xl font-heading text-gpp-text leading-tight">{member.name}</h4>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Production Team -->
  <div class="team-category mb-16">
    {
      divisionData.map((division) => (
        <div class="mb-16">
          <div class="flex flex-col mb-8">
            <h3 class="text-3xl md:text-4xl font-heading text-gpp-accent mb-2 inline-block border-b-4 border-gpp-accent pb-2">
              {division.name}
            </h3>
            <p class="text-gpp-text/80 font-medium">The creative force bringing the game to life.</p>
          </div>
          
          <div class="flex flex-wrap gap-4 md:gap-6">
            {division.members.map((member) => (
              <div class="group flex items-center gap-3 bg-white border-2 border-gpp-primary/20 rounded-full py-2 px-5 hover:-translate-y-1 transition-transform duration-300 cursor-default shadow-sm">
                <div class="w-3 h-3 rounded-full bg-gpp-accent border-2 border-gpp-primary" />
                <span class="font-bold text-sm md:text-base text-gpp-primary">{member.name}</span>
                <div class="w-2 h-2 rounded-full bg-gpp-primary/20"></div>
                <span class="text-xs font-heading uppercase text-gpp-text/80 bg-gpp-bg px-2 py-1 rounded-md border-2 border-gpp-primary/20">{member.role}</span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
