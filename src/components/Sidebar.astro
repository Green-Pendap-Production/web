---
// The sidebar has been converted to a static desktop logo watermark.
---

<div class="fixed bottom-16 right-8 md:bottom-16 md:right-8 z-50 pointer-events-none hidden md:block">
    <div class="relative group">
        <!-- Glowing effect behind logo -->
        <div class="absolute inset-0 bg-gpp-primary/20 blur-xl rounded-full scale-110 group-hover:bg-gpp-primary/40 transition-colors duration-500"></div>
        <img
            src="/logo.svg"
            alt="Green Pendap Logo"
            class="relative w-16 md:w-24 h-auto opacity-80 drop-shadow-[2px_4px_0_rgba(47,79,47,0.4)] group-hover:opacity-100 group-hover:-translate-y-1 transition-all duration-300"
        />
    </div>
</div>
