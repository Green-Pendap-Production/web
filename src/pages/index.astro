---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import HeroBackground from "../components/HeroBackground.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import Progress from "../components/Progress.astro";
import TeamTree from "../components/TeamTree.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";

// Import images
import bantalBattleImage from "../assets/pillow2.png";
import bantalBattleImage2 from "../assets/pillow.png";
import heroImage from "../assets/hero.jpeg";
import weImage from "../assets/we.jpeg";
import satu from "../assets/bg/1.jpeg";
import dua from "../assets/bg/2.jpeg";

const allGames = [
    {
        title: "Pillow Fight",
        genre: "Competitive",
        image: bantalBattleImage2,
        year: "2026",
    },
];

const progressItems = [
    {
        title: "GPP REKON",
        date: "JUN 2026",
        image: bantalBattleImage,
        description: "Change structure of our new studio to expand.",
    },
    {
        title: "Environment Art Preview",
        date: "FEB 2026",
        image: satu,
        description:
            "Initial look at the lush, hand-painted backgrounds inspired by Bengkulu's landscapes.",
    },
    {
        title: "Character Animation Refinement",
        date: "JAN 2026",
        image: dua,
        description:
            "Polishing character movement and secondary animations to add more life to the world.",
    },
];
---

<Layout title="Green Pendap Production">
    <!-- Hero Section -->
    <section
        id="home"
        class="min-h-svh flex flex-col justify-center mb-12 md:mb-24 relative overflow-hidden"
    >
        <HeroBackground src={heroImage} />

        <div
            class="relative z-10 pointer-events-none mt-12 md:mt-20 lg:mt-0 container mx-auto px-2 md:px-4 flex flex-col justify-center"
        >
            <div
                class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center w-full"
            >
                <div class="flex flex-col items-start w-full lg:col-span-7">
                    <h1
                        class="text-6xl sm:text-7xl md:text-7xl lg:text-7xl xl:text-8xl 2xl:text-9xl font-heading text-gpp-primary leading-[0.9] mb-6 md:mb-8 tracking-tighter drop-shadow-sm flex flex-col items-start"
                    >
                        <span
                            class="relative group inline-block cursor-default pointer-events-auto whitespace-nowrap"
                        >
                            <span
                                class="absolute inset-0 bg-gpp-primary scale-x-0 group-hover:scale-x-110 -left-[2%] w-[105%] transition-transform duration-500 origin-left ease-out -skew-x-6 -z-10"
                            ></span>
                            <span
                                class="relative z-10 group-hover:text-gpp-bg transition-colors duration-300"
                                >OUR GAME</span
                            >
                        </span>
                        <span
                            class="relative group inline-block cursor-default pointer-events-auto whitespace-nowrap"
                        >
                            <span
                                class="absolute inset-0 bg-gpp-accent scale-x-0 group-hover:scale-x-110 -left-[2%] w-[105%] transition-transform duration-500 origin-left ease-out -skew-x-6 -z-10"
                            ></span>
                            <span
                                class="relative z-10 group-hover:text-gpp-bg transition-colors duration-300"
                                >IS MADE</span
                            >
                        </span>
                        <span
                            class="relative group inline-block cursor-default pointer-events-auto whitespace-nowrap"
                        >
                            <span
                                class="absolute inset-0 bg-gpp-primary scale-x-0 group-hover:scale-x-110 -left-[2%] w-[105%] transition-transform duration-500 origin-left ease-out -skew-x-6 -z-10"
                            ></span>
                            <span
                                class="relative z-10 text-transparent bg-clip-text bg-linear-to-br from-gpp-primary to-gpp-accent/80 group-hover:text-gpp-bg group-hover:bg-none transition-all duration-300"
                                >WITH LOVE</span
                            >
                        </span>
                    </h1>

                    <p
                        class="text-base md:text-xl text-gpp-text/80 max-w-xl mb-10 font-medium pointer-events-auto leading-relaxed"
                    >
                        Crafting unique interactive experiences wrapped in
                        layers of mystery and local flavor. We believe in the
                        power of stories that connect us all.
                    </p>

                    <div
                        class="flex flex-wrap items-center gap-6 pointer-events-auto"
                    >
                        <a
                            href="#games"
                            class="inline-flex items-center gap-2 bg-gpp-primary text-gpp-bg px-6 py-3 rounded-full hover:bg-gpp-accent transition-colors duration-300 font-bold text-sm md:text-base shadow-md hover:shadow-lg group"
                        >
                            View Our Work
                            <span
                                class="group-hover:translate-x-1 transition-transform duration-300"
                                >&darr;</span
                            >
                        </a>
                        <a
                            href="#about"
                            class="inline-flex items-center gap-2 text-gpp-text/70 hover:text-gpp-primary transition-colors duration-300 font-bold text-sm md:text-base border-b-2 border-transparent hover:border-gpp-primary pb-1"
                        >
                            Read Our Story
                        </a>
                    </div>
                </div>

                <div
                    class="hidden lg:flex lg:col-span-5 relative justify-center items-center pointer-events-auto group"
                >
                    <div
                        class="absolute inset-0 bg-gpp-primary/10 rounded-3xl transform rotate-3 scale-105 -z-10 transition-transform duration-500 group-hover:rotate-6"
                    >
                    </div>
                    <div
                        class="absolute inset-0 bg-gpp-accent/10 rounded-3xl transform -rotate-2 scale-105 -z-20 transition-transform duration-500 group-hover:-rotate-4 group-hover:scale-110"
                    >
                    </div>

                    <div
                        class="bg-gpp-bg p-4 shadow-xl border border-gpp-text/10 rounded-2xl transform transition-transform duration-500 group-hover:-translate-y-2 group-hover:shadow-2xl w-full max-w-sm"
                    >
                        <Image
                            src={heroImage}
                            alt="Green Pendap Production Studio"
                            class="rounded-xl w-full h-auto object-cover aspect-4/5 object-center grayscale group-hover:grayscale-0 transition-all duration-700"
                        />
                        <div
                            class="flex items-center justify-between mt-4 px-2"
                        >
                            <span class="text-xs font-mono text-gpp-muted"
                                >GPP_HQ_01</span
                            >
                            <span
                                class="text-xs font-serif italic text-gpp-primary font-semibold"
                                >Behind the scenes</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Games Section -->
    <section id="games" class="mb-16 md:mb-32 pt-8 md:pt-16">
        <h2
            class="text-3xl md:text-4xl font-heading text-gpp-primary mb-8 md:mb-12 border-b border-gpp-text/10 pb-4"
        >
            Selected Works
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-16">
            {allGames.map((game) => <ProjectCard {...game} />)}
        </div>
    </section>

    <!-- About Section -->
    <section
        id="about"
        class="mb-16 md:mb-32 pt-8 md:pt-16 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12"
    >
        <div class="col-span-12 md:col-span-4">
            <h2
                class="text-3xl md:text-4xl font-heading text-gpp-primary mb-4 md:mb-6 border-b border-gpp-text/10 pb-4"
            >
                Our Studio
            </h2>
        </div>
        <div
            class="col-span-12 md:col-span-8 space-y-8 text-lg leading-relaxed"
        >
            <p class="text-xl md:text-2xl font-serif italic text-gpp-accent">
                Founded in 2025 in the heart of Bengkulu, Indonesia.
            </p>
            <p>
                We are a diverse team of artists, programmers, and storytellers
                who believe in the power of interactive media. Like the <span
                    class="text-gpp-primary font-bold">Pendap</span
                > a traditional dish wrapped in leaves our games are wrapped in layers
                of mystery and flavor.
            </p>

            <div class="mt-12 w-full">
                <ImageCarousel images={[heroImage, weImage, satu]} />
            </div>
        </div>
    </section>

    <!-- Progress Section -->
    <section id="progress" class="mb-16 md:mb-32 pt-8 md:pt-16">
        <div class="flex flex-col mb-10 md:mb-14">
            <h2 class="text-3xl md:text-5xl font-heading text-gpp-primary">
                Work in Progress
            </h2>
        </div>
        <Progress items={progressItems} />
    </section>

    <!-- Team Section -->
    <section id="team" class="mb-16 md:mb-32 pt-8 md:pt-16">
        <div
            class="flex flex-col md:flex-row md:items-end md:justify-between mb-10 md:mb-14 border-b border-gpp-text/10 pb-6"
        >
            <div>
                <span
                    class="text-xs font-mono uppercase tracking-[0.2em] text-gpp-muted mb-2 block"
                    >The People</span
                >
                <h2 class="text-3xl md:text-5xl font-heading text-gpp-primary">
                    Our Team
                </h2>
            </div>
            <p class="text-sm text-gpp-muted mt-3 md:mt-0 max-w-xs">
                A passionate group of creators bringing games to life from
                Bengkulu, Indonesia.
            </p>
        </div>

        <TeamTree />
    </section>
</Layout>
