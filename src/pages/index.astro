---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import HeroBackground from "../components/HeroBackground.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import Progress from "../components/Progress.astro";
import TeamTree from "../components/TeamTree.astro";
import Window from "../components/Window.astro";
import DesktopIcon from "../components/DesktopIcon.astro";
import DesktopContextMenu from "../components/DesktopContextMenu.astro";
import { Image } from "astro:assets";

// Import images
import bantalBattleImage from "../assets/pillow2.png";
import bantalBattleImage2 from "../assets/pillow.png";
import heroImage from "../assets/hero.jpeg";
import weImage from "../assets/we.jpeg";
import satu from "../assets/bg/1.jpeg";
import dua from "../assets/bg/2.jpeg";

const desktopIcons = [
    { id: "home", label: "Welcome.exe", type: "exe" as const },
    { id: "games", label: "Games", type: "folder" as const },
    { id: "about", label: "About.txt", type: "txt" as const },
    { id: "progress", label: "DevLog.exe", type: "exe" as const },
    { id: "team", label: "Team.exe", type: "exe" as const },
    { id: "contact", label: "Contact.msg", type: "msg" as const },
];

const allGames = [
    {
        title: "Pillow Fight",
        genre: "Competitive",
        image: bantalBattleImage2,
        year: "2026",
    },
];

const progressItems = [
    {
        title: "GPP REKON",
        date: "JUN 2026",
        image: bantalBattleImage,
        description: "Change structure of our new studio to expand.",
    },
    {
        title: "Environment Art Preview",
        date: "FEB 2026",
        image: satu,
        description:
            "Initial look at the lush, hand-painted backgrounds inspired by Bengkulu's landscapes.",
    },
    {
        title: "Character Animation Refinement",
        date: "JAN 2026",
        image: dua,
        description:
            "Polishing character movement and secondary animations to add more life to the world.",
    },
];
---

<Layout title="Green Pendap Production | Desktop">
    <!-- Background / Wallpaper -->
    <div
        class="absolute inset-0 z-0 bg-linear-to-br from-[#8dbd8d] to-[#4b7a4b] pointer-events-auto overflow-hidden"
    >
        <HeroBackground src={heroImage} />
        <!-- Subtle Grid Pattern -->
        <div
            class="absolute inset-0"
            style="background-image: linear-gradient(rgba(255,255,255,0.1) 2px, transparent 2px), linear-gradient(90deg, rgba(255,255,255,0.1) 2px, transparent 2px); background-size: 100px 100px;"
        >
        </div>
    </div>

    <!-- Desktop Icons -->
    <div class="absolute top-4 left-4 md:top-8 md:left-8 z-0 grid grid-cols-2 md:grid-cols-1 gap-2 md:gap-4 pointer-events-auto items-start justify-items-center md:justify-items-start max-h-screen overflow-hidden hidden sm:grid">
        {desktopIcons.map(icon => <DesktopIcon {...icon} />)}
    </div>

    <!-- Windows Container -->
    <div
        id="desktop-area"
        class="relative w-full flex flex-col gap-12 p-4 pt-28 pb-32 md:p-0 md:absolute md:inset-0 md:z-10 md:pointer-events-none md:block"
    >
        <!-- Welcome Window -->
        <Window
            id="home"
            title="Welcome.exe"
            isOpen={false}
            initialX="calc(50vw - 350px)"
            initialY="calc(50vh - 350px)"
            width="w-[90vw] md:w-[700px] max-w-[95vw]"
        >
            <div class="flex flex-col items-center text-center relative pt-8">
                <!-- Floating Sticker -->
                <div
                    class="absolute top-0 right-0 md:top-2 md:right-4 bg-[#ffeb3b] text-gpp-primary font-bold px-4 py-2 rounded-xl border-4 border-gpp-primary transform rotate-6 shadow-[4px_4px_0px_0px_rgba(47,79,47,1)] z-20 hidden sm:block"
                >
                    Made with <span class="text-[#ff4747]">♥</span>
                </div>

                <!-- Giant Heading -->
                <h1
                    class="text-5xl sm:text-6xl md:text-[5rem] font-heading text-gpp-primary leading-none mb-6 drop-shadow-[4px_4px_0_rgba(47,79,47,0.2)] tracking-tight"
                >
                    GREEN PENDAP<br />
                    <span
                        class="text-gpp-accent text-4xl sm:text-5xl md:text-[4rem] block mt-2"
                        >PRODUCTION</span
                    >
                </h1>

                <p
                    class="text-base md:text-lg text-gpp-text/80 max-w-xl mb-10 font-medium leading-relaxed bg-white/50 p-4 rounded-xl border-2 border-gpp-primary/20 border-dashed"
                >
                    Crafting unique interactive experiences wrapped in layers of
                    mystery and local flavor. We believe in the power of stories
                    that connect us all.
                </p>

                <!-- Polaroid Photo -->
                <div class="w-full max-w-sm mx-auto mb-6 relative">
                    <!-- Red Pin -->
                    <div
                        class="absolute -top-3 left-1/2 -translate-x-1/2 w-6 h-6 rounded-full bg-[#ff4747] border-4 border-gpp-primary shadow-[0_4px_0_0_rgba(47,79,47,1)] z-20"
                    >
                    </div>
                    <!-- Photo Frame -->
                    <div
                        class="bg-white p-3 pb-12 shadow-[8px_8px_0px_0px_rgba(47,79,47,1)] border-4 border-gpp-primary transform transition-transform duration-500 hover:-translate-y-2 w-full relative rotate-2"
                    >
                        <Image
                            src={heroImage}
                            alt="Green Pendap Production Studio"
                            class="w-full h-auto object-cover aspect-4/5 object-center border-4 border-gpp-primary/10"
                        />
                        <div
                            class="absolute bottom-3 left-1/2 -translate-x-1/2 text-gpp-primary font-heading text-xl uppercase tracking-widest opacity-80"
                        >
                            GPP_HQ_01
                        </div>
                    </div>
                </div>
            </div>
        </Window>

        <!-- Games Window -->
        <Window
            id="games"
            title="Games_Folder"
            initialX="40vw"
            initialY="5vh"
            width="w-[90vw] md:w-[800px] max-w-[95vw]"
        >
            <h2
                class="text-3xl md:text-4xl font-heading text-gpp-primary mb-6 border-b-4 border-gpp-primary pb-2 inline-block"
            >
                Selected Works
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {allGames.map((game) => <ProjectCard {...game} />)}
            </div>
        </Window>

        <!-- About Window -->
        <Window
            id="about"
            title="About_Studio.txt"
            initialX="5vw"
            initialY="15vh"
            width="w-[90vw] md:w-[750px] max-w-[95vw]"
        >
            <div class="space-y-6 text-lg leading-relaxed">
                <h2
                    class="text-3xl font-heading text-gpp-primary border-b-4 border-gpp-primary pb-2 inline-block"
                >
                    Our Studio
                </h2>
                <p
                    class="text-xl md:text-2xl font-serif italic text-gpp-accent bg-yellow-100 p-4 border-2 border-gpp-accent rounded-xl shadow-[4px_4px_0px_0px_rgba(139,90,43,1)]"
                >
                    Founded in 2025 in the heart of Bengkulu, Indonesia.
                </p>
                <p class="font-medium">
                    We are a diverse team of artists, programmers, and
                    storytellers who believe in the power of interactive media.
                    Like the <span class="text-gpp-primary font-bold text-xl"
                        >Pendap</span
                    > a traditional dish wrapped in leaves our games are wrapped in
                    layers of mystery and flavor.
                </p>
                <div
                    class="mt-8 w-full border-4 border-gpp-primary rounded-3xl overflow-hidden shadow-[4px_4px_0px_0px_rgba(47,79,47,1)]"
                >
                    <ImageCarousel images={[heroImage, weImage, satu]} />
                </div>
            </div>
        </Window>

        <!-- Progress Window -->
        <Window
            id="progress"
            title="DevLog_Tracker"
            initialX="35vw"
            initialY="20vh"
            width="w-[90vw] md:w-[800px] max-w-[95vw]"
        >
            <h2
                class="text-3xl md:text-4xl font-heading text-gpp-primary mb-6 border-b-4 border-gpp-primary pb-2 inline-block"
            >
                Work in Progress
            </h2>
            <div
                class="bg-white/50 p-4 rounded-2xl border-2 border-gpp-primary border-dashed"
            >
                <Progress items={progressItems} />
            </div>
        </Window>

        <!-- Team Window -->
        <Window
            id="team"
            title="Team_Roster.exe"
            initialX="10vw"
            initialY="2vh"
            width="w-[95vw] md:w-[850px] max-w-[95vw]"
            height="max-h-[85vh]"
        >
            <div class="mb-8">
                <span
                    class="text-xs font-bold uppercase tracking-widest text-gpp-accent bg-yellow-100 px-2 py-1 rounded-md border border-gpp-accent mb-2 inline-block"
                    >The People</span
                >
                <h2 class="text-3xl md:text-5xl font-heading text-gpp-primary">
                    Our Team
                </h2>
                <p class="text-sm font-medium mt-2 max-w-xs">
                    A passionate group of creators bringing games to life from
                    Bengkulu, Indonesia.
                </p>
            </div>

            <TeamTree />
        </Window>

        <!-- Contact Window (Since it's in the menu) -->
        <Window
            id="contact"
            title="Contact.msg"
            initialX="50vw"
            initialY="25vh"
            width="w-[90vw] md:w-[500px] max-w-[95vw]"
        >
            <div class="text-center py-8">
                <h2 class="text-3xl font-heading text-gpp-primary mb-4">
                    Let's Connect!
                </h2>
                <p class="font-medium mb-6">
                    Want to collaborate or just say hi?
                </p>
                <a
                    href="mailto:greenpendapi@gmail.com"
                    class="inline-block bg-gpp-primary text-white font-bold py-3 px-8 rounded-full border-4 border-gpp-primary hover:bg-gpp-accent hover:border-gpp-accent transition-colors shadow-[4px_4px_0px_0px_rgba(47,79,47,1)] hover:-translate-y-1 hover:shadow-[4px_8px_0px_0px_rgba(47,79,47,1)]"
                >
                    greenpendapi@gmail.com
                </a>
            </div>
        </Window>
    </div>

    <!-- Right-click context menu di area desktop -->
    <DesktopContextMenu icons={desktopIcons} />
</Layout>

<script>
    import { gsap } from "gsap";
    import { Draggable } from "gsap/Draggable";

    gsap.registerPlugin(Draggable);

    document.addEventListener("DOMContentLoaded", () => {
        let zIndexCounter = 100;
        const windows = document.querySelectorAll("[data-window]");

        // Initialize Draggable for each window individually ONLY on Desktop
        if (window.innerWidth >= 768) {
            windows.forEach((win) => {
                const header = win.querySelector(".window-header");
                Draggable.create(win, {
                    type: "x,y",
                    handle: header,
                    edgeResistance: 0.65,
                    onPress: function () {
                        zIndexCounter++;
                        gsap.set(this.target, { zIndex: zIndexCounter });
                    },
                });
            });
        }

        // Handle Close Buttons
        const closeBtns = document.querySelectorAll(".window-close-btn");
        closeBtns.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const targetId = (btn as HTMLElement).dataset.target;
                if (targetId) {
                    const win = document.getElementById(targetId);
                    if (win) {
                        gsap.to(win, {
                            scale: 0.75,
                            opacity: 0,
                            duration: 0.3,
                            ease: "back.in(1.5)",
                            onComplete: () => {
                                win.classList.remove(
                                    "pointer-events-auto",
                                    "md:pointer-events-auto",
                                );
                                win.classList.add(
                                    "pointer-events-none",
                                    "md:pointer-events-none",
                                );
                            },
                        });
                    }
                }
            });
        });

        // Bring to front on click anywhere in window
        windows.forEach((win) => {
            win.addEventListener("mousedown", () => {
                zIndexCounter++;
                gsap.set(win, { zIndex: zIndexCounter });
            });
        });
        
        const sfxSource = new Audio("https://cdn.freesound.org/previews/708/708605_13515726-lq.mp3");
        sfxSource.preload = "auto";

        // Expose openWindow globally so Sidebar can call it
        (window as any).openWindow = function (id: string) {
            const win = document.getElementById(`window-${id}`);
            if (win) {
                if (window.innerWidth < 768) {
                    // Mobile: Just scroll to it
                    win.scrollIntoView({ behavior: "smooth" });
                    return;
                }

                 const sfx = sfxSource.cloneNode() as HTMLAudioElement;
                    sfx.volume = 0.5;
                    sfx.play().catch(() => {});


                zIndexCounter++;
                gsap.set(win, { zIndex: zIndexCounter });
                win.classList.remove(
                    "pointer-events-none",
                    "md:pointer-events-none",
                );
                win.classList.add(
                    "pointer-events-auto",
                    "md:pointer-events-auto",
                );
                gsap.fromTo(
                    win,
                    { scale: 0.75, opacity: 0 },
                    {
                        scale: 1,
                        opacity: 1,
                        duration: 0.4,
                        ease: "back.out(1.5)",
                    },
                );
            }
        };

        // Handle window spawn sequence AFTER boot screen completes
        document.addEventListener("bootComplete", () => {
            if (window.innerWidth >= 768) {
                // Desktop Startup Animation Sequence
                // Jendela bermunculan dari bawah tumpukan secara berurutan
                setTimeout(() => (window as any).openWindow("about"), 300);
                setTimeout(() => (window as any).openWindow("contact"), 500);
                setTimeout(() => (window as any).openWindow("progress"), 700);
                setTimeout(() => (window as any).openWindow("team"), 900);
                setTimeout(() => (window as any).openWindow("games"), 1100);
                // Terakhir, Welcome.exe tepat di tengah layar!
                setTimeout(() => (window as any).openWindow("home"), 1300);
            } else {
                // Mobile behavior remains unaffected
                setTimeout(() => (window as any).openWindow("about"), 100);
                setTimeout(() => (window as any).openWindow("contact"), 200);
                setTimeout(() => (window as any).openWindow("progress"), 300);
                setTimeout(() => (window as any).openWindow("team"), 400);
                setTimeout(() => (window as any).openWindow("games"), 500);
                setTimeout(() => (window as any).openWindow("home"), 600);
            }
        });

        // Desktop Icons logic
        const desktopIcons = document.querySelectorAll('.desktop-icon');
        desktopIcons.forEach(icon => {
            icon.addEventListener('click', (e) => {
                const targetId = icon.getAttribute('data-target');
                if (targetId) {
                    (window as any).openWindow(targetId);
                }
            });
        });
    });
</script>
